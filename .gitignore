# Dependencies — restored by `npm ci`, never committed.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Next.js generated route types
.next/types/

# Test / coverage
coverage/
.nyc_output/

# Environment — secrets never enter git history
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Vercel
.vercel

# Local Claude Code state (launch config is shared; local overrides are not)
.claude/settings.local.json
